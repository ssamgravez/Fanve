# Fanvue OAuth 2.0 Credentials
# Obtain these from https://fanvue.com/developers/apps
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here

# The URL where Fanvue will redirect after authentication
# Must match exactly what is registered in the Developer Portal
REDIRECT_URI=http://localhost:3000/api/auth/callback

# Base URL of your app
NEXT_PUBLIC_APP_URL=http://localhost:3000
